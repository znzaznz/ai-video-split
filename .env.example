# DashScope API key (Alibaba Model Studio)
# Example: DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
DASHSCOPE_API_KEY=

# Optional defaults
OUTPUT_DIR=runs
POLL_INTERVAL=2
TIMEOUT=900

# 转写纠错（切片机 / 视频转写纠错.exe 共用）
TRANSCRIPT_KEYWORDS=
TRANSCRIPT_LLM_CORRECT=1
# 转写后从正文抽样抽专名（1=开启）；无 Ollama 且未填关键词时用云端
TRANSCRIPT_GLOSSARY_LLM=1
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
