# DashScope API key (Alibaba Model Studio)
# Example: DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
DASHSCOPE_API_KEY=

# Optional defaults
OUTPUT_DIR=runs
POLL_INTERVAL=2
TIMEOUT=900

# 转写纠错（切片机 / 视频转写纠错.exe 共用）
TRANSCRIPT_KEYWORDS=
TRANSCRIPT_LLM_CORRECT=1
# 转写后从正文抽样抽专名（1=开启）；无 Ollama 且未填关键词时用云端
TRANSCRIPT_GLOSSARY_LLM=1
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# 转写后处理：correct | polish | none（GUI / transcript_cli 可覆盖）
TRANSCRIPT_POST_ASR_MODE=correct

# 抖音下载 Cookie（Netscape 格式 cookies.txt 放仓库根）
# YT_DLP_COOKIES=cookies.txt
# YT_DLP_COOKIES_FROM_BROWSER=

# chat-ui 转写查证（Gemini 对话）：优先在应用内「设置」填写，也可在此配置
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
